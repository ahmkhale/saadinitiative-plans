{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saadinitiative.com/schemas/plan.schema.json",
  "title": "Saad academic plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "major",
    "semesters"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "university": false,
    "college": false,
    "major": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "degree": {
      "type": "string"
    },
    "planCode": {
      "type": "string"
    },
    "version": false,
    "edition": false,
    "release": false,
    "headerSubtitle": {
      "type": "string"
    },
    "expectedCredits": {
      "type": "number",
      "minimum": 0
    },
    "sortCourses": {
      "enum": [
        "input",
        "code"
      ]
    },
    "courseColors": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      }
    },
    "sharedSemesterSets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "copyright": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "semesters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semester"
      }
    },
    "electiveGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/electiveGroup"
      }
    },
    "proposal": {
      "type": "object",
      "required": [
        "semesters"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "showGuide": {
          "type": "boolean"
        },
        "semesters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/proposalSemester"
          }
        }
      },
      "additionalProperties": false
    },
    "fallbackCourses": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/courseFacts"
      }
    }
  },
  "allOf": [
    {
      "if": { "not": { "required": ["track"] } },
      "then": {
        "properties": {
          "semesters": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "phase": {
      "type": "object",
      "required": [
        "label",
        "start",
        "end"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "semester": {
      "type": "object",
      "required": [
        "id",
        "courses"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expectedCredits": {
          "type": "number",
          "minimum": 0
        },
        "sortCourses": {
          "enum": [
            "input",
            "code"
          ]
        },
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/courseEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "electiveGroup": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "sourceId"
          ],
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "name",
            "courses"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "requiredHours": {
              "type": "number",
              "minimum": 0
            },
            "requirementText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "sortCourses": {
              "enum": [
                "input",
                "code"
              ]
            },
            "courses": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/courseEntry"
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "requiredHours"
              ],
              "not": {
                "required": [
                  "requirementText"
                ]
              }
            },
            {
              "required": [
                "requirementText"
              ],
              "not": {
                "required": [
                  "requiredHours"
                ]
              }
            }
          ],
          "additionalProperties": true
        }
      ],
      "type": "object"
    },
    "proposalSemester": {
      "type": "object",
      "required": [
        "id",
        "type",
        "courseOrder",
        "placeholders"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceSemesterId": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "regular",
            "summer"
          ]
        },
        "courseOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "placeholders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposalPlaceholder"
          }
        }
      },
      "additionalProperties": false
    },
    "proposalPlaceholder": {
      "type": "object",
      "required": [
        "id",
        "name",
        "academicHours",
        "lectureHours",
        "exerciseHours",
        "practicalHours"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "academicHours": {
          "type": "number",
          "minimum": 0
        },
        "lectureHours": {
          "type": "number",
          "minimum": 0
        },
        "exerciseHours": {
          "type": "number",
          "minimum": 0
        },
        "practicalHours": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "courseEntry": {
      "type": "object",
      "required": [
        "id",
        "code",
        "prerequisites",
        "corequisites",
        "minimumCompletedCredits",
        "prerequisiteConditions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "corequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forcedCorequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prerequisiteAlternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "minimumCompletedCredits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "prerequisiteConditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extinct": {
          "type": "boolean"
        },
        "forceFallback": {
          "type": "boolean"
        },
        "preserveSameSemesterPrerequisite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "courseFacts": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "academicHours": {
          "type": "number",
          "minimum": 0
        },
        "lectureHours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "practicalHours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "exerciseHours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "category": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "extinct": {
          "type": "boolean"
        },
        "source": {
          "enum": [
            "catalog",
            "manual"
          ]
        },
        "manuallyEditedFields": {
          "type": "array",
          "items": {
            "enum": [
              "name",
              "academicHours",
              "lectureHours",
              "exerciseHours",
              "practicalHours"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
